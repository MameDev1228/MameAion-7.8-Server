<?xml version="1.0" encoding="utf-8"?>
<xs:schema version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="decompose_stuff_templates">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="decompose_stuff_template" type="DecomposeStuffTemplate" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:complexType name="DecomposeStuffTemplate">
        <xs:sequence>
            <xs:element name="decompse_item" type="DecomposeStuffResult" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:int" use="required"/>
        <xs:attribute name="name" type="xs:string" use="optional"/>
    </xs:complexType>
    <xs:complexType name="DecomposeStuffResult">
        <xs:attribute name="item_id" type="xs:int" use="required"/>
    </xs:complexType>
</xs:schema>
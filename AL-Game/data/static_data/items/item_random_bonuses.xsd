<?xml version="1.0" encoding="utf-8"?>
<xs:schema elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:include schemaLocation="../modifiers.xsd"/>
	<xs:element name="real_random_templates">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="real_random_template" type="RandomBonus" minOccurs="0" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="RandomBonus">
		<xs:sequence>
			<xs:element name="random_attr" type="RandomAttr" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="id" type="xs:int" use="required"/>
		<xs:attribute name="option_num" type="xs:int" use="required"/>
	</xs:complexType>
	<xs:complexType name="RandomAttr">
		<xs:attribute name="stat_name" type="modifiersenum"/>
		<xs:attribute name="min_value" type="xs:int"/>
		<xs:attribute name="max_value" type="xs:int"/>
	</xs:complexType>
</xs:schema>
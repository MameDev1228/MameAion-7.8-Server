<?xml version="1.0" encoding="UTF-8"?>
<xs:schema version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:include schemaLocation="../modifiers.xsd"/>
    <xs:include schemaLocation="../stats/stats.xsd"/>
    <xs:include schemaLocation="../import.xsd"/>
    <xs:element name="monster_core_templates">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="monster_core_template" type="MonsterCoreTemplate" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:complexType name="MonsterCoreTemplate">
        <xs:sequence>
            <xs:element name="core_list" type="MonsterCoreList" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="xs:int"/>
		<xs:attribute name="name" type="xs:string"/>
        <xs:attribute name="category" type="xs:int"/>
        <xs:attribute name="maxRank" type="xs:int"/>
        <xs:attribute name="quality" type="MonsterCoreType" use="required"/>
        <xs:attribute name="itemId" type="xs:int"/>
    </xs:complexType>
    <xs:complexType name="MonsterCoreList">
        <xs:attribute name="id" type="xs:int"/>
        <xs:attribute name="level" type="xs:int"/>
        <xs:attribute name="stat" type="modifiersenum" use="required"/>
        <xs:attribute name="value" type="xs:int"/>
    </xs:complexType>
    <xs:simpleType name="MonsterCoreType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="GOLD"/>
            <xs:enumeration value="SILVER"/>
            <xs:enumeration value="BRONZE"/>
			<xs:enumeration value="PLATINUM"/>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
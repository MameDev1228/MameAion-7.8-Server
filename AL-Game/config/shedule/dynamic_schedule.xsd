<?xml version="1.0" standalone="yes"?>
<xs:schema version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="dynamic" type="dynamic"/>
	<xs:element name="dynamic_schedule" type="dynamicSchedule"/>
	<xs:complexType name="dynamicSchedule">
		<xs:sequence>
			<xs:element ref="dynamic" minOccurs="1" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="dynamic">
		<xs:sequence>
			<xs:element name="riftTime" type="xs:string" maxOccurs="unbounded"/>
		</xs:sequence>
		<xs:attribute name="id" type="xs:int" use="required"/>
	</xs:complexType>
</xs:schema>
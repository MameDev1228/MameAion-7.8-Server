<?xml version="1.0" encoding="UTF-8"?>
<xs:schema version="1.0" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:include schemaLocation="../modifiers.xsd"/>
    <xs:include schemaLocation="../stats/stats.xsd"/>
    <xs:include schemaLocation="../import.xsd"/>
    <xs:element name="atreian_passport_templates">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="atreian_passport_template" type="LoginEventTemplate" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:complexType name="LoginEventTemplate">
        <xs:sequence>
            <xs:element name="stamp_reward" type="StampReward" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
		<xs:attribute name="id" type="xs:int" use="required"/>
		<xs:attribute name="name" type="xs:string" use="required"/>
		<xs:attribute name="type" type="xs:string" use="required"/>
    </xs:complexType>
	<xs:complexType name="StampReward">
        <xs:attribute name="item_id" type="xs:int"/>
		<xs:attribute name="count" type="xs:int"/>
		<xs:attribute name="stamp" type="xs:int"/>
		<xs:attribute name="required_level" type="xs:int" use="optional"/>
    </xs:complexType>
</xs:schema>